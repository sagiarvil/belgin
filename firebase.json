{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "site": "belgin",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebaserc.example",
      ".github/**",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "scripts/**",
      "scratch/**",
      "izko-rates-cache.json",
      "*.log",
      "belgin_kuyumculuk_hukuki_sozlesme_paketi/**",
      "**/*.docx",
      "**/*.xlsx",
      "**/*.pdf",
      "AGENTS.md",
      "DESIGN.md",
      "package.json",
      "package-lock.json",
      "*kopyası.txt",
      "README.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https: https://*.bkm.com.tr https://*.kuveytturk.com.tr https://accounts.google.com; script-src 'self' 'unsafe-inline' https://cdn.socket.io https://cdnjs.cloudflare.com https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: https://*.googleusercontent.com; connect-src 'self' https: wss: https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.firebaseio.com https://*.googleapis.com https://www.gstatic.com https://www.paytr.com https://finans.truncgil.com https://canlipiyasalar.haremaltin.com https://hrmsocketonly.haremaltin.com wss://hrmsocketonly.haremaltin.com wss://socket.haremaltin.com https://*.kuveytturk.com.tr; frame-src 'self' https: https://*.firebaseapp.com https://accounts.google.com https://www.paytr.com https://www.google.com https://maps.google.com https://*.bkm.com.tr https://*.kuveytturk.com.tr; media-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), usb=(), browsing-topics=()"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          },
          {
            "key": "Cross-Origin-Resource-Policy",
            "value": "same-site"
          },
          {
            "key": "X-Permitted-Cross-Domain-Policies",
            "value": "none"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|woff|woff2|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          }
        ]
      },
      {
        "source": "/llms/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/markdown; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ],
    "cleanUrls": false,
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/admin/delil-tutunagi",
        "destination": "/hukuki-evrak-yazdir.html"
      },
      {
        "source": "/api/admin/statement",
        "function": "adminStatementApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/statement/**",
        "function": "adminStatementApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/statement/payment/delete",
        "function": "adminStatementApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/statement/payment",
        "function": "adminStatementApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/statement/pos-entry/delete",
        "function": "adminStatementApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/statement/pos-entry",
        "function": "adminStatementApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/statement/set-pos-rate",
        "function": "adminStatementApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/store-invoices/delete",
        "function": "adminStoreInvoicesApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/store-invoices/create",
        "function": "adminStoreInvoicesApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/store-invoices",
        "function": "adminStoreInvoicesApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/store-invoices/**",
        "function": "adminStoreInvoicesApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/invoice/draft",
        "function": "adminInvoiceApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/invoice/batch-draft",
        "function": "adminInvoiceApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/invoice/batch-sign",
        "function": "adminInvoiceApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/invoice/send-sms",
        "function": "adminInvoiceApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/invoice/sign",
        "function": "adminInvoiceApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/invoice/view",
        "function": "adminInvoiceApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/invoice/force-logout",
        "function": "adminInvoiceApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/invoice/**",
        "function": "adminInvoiceApi",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/orders/create",
        "function": "createAdminOrder",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/orders/delete",
        "function": "deleteAdminOrder",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/orders/status",
        "function": "updateAdminOrderStatus",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/orders/confirm",
        "function": "confirmAdminOrder",
        "region": "us-central1"
      },
      {
        "source": "/api/admin/orders",
        "function": "getAdminOrders",
        "region": "us-central1"
      },
      {
        "source": "/api/market/izko-rates",
        "function": "getIzkoRates"
      },
      {
        "source": "/api/payment/create",
        "function": "createPayment"
      },
      {
        "source": "/api/payment/status",
        "function": "getPaymentStatus"
      },
      {
        "source": "/api/payment/debug-egress",
        "function": "debugEgressIp"
      },
      {
        "source": "/api/payment/callback/paytr",
        "function": "paymentCallback"
      },
      {
        "source": "/api/payment/callback/qnb",
        "function": "paymentCallback"
      },
      {
        "source": "/api/payment/callback/kuveytturk",
        "function": "paymentCallback"
      },
      {
        "source": "/api/payment/callback/yapikredi",
        "function": "paymentCallback"
      },
      {
        "source": "/odeme-basarili",
        "destination": "/odeme-basarili.html"
      },
      {
        "source": "/odeme-basarisiz",
        "destination": "/odeme-basarisiz.html"
      },
      {
        "source": "/vip",
        "destination": "/vip-odeme.html"
      },
      {
        "source": "/vip/**",
        "destination": "/vip-odeme.html"
      },
      {
        "source": "/odeme-linki",
        "destination": "/odeme-linki.html"
      },
      {
        "source": "/api/createPayTRToken",
        "function": "createPayTRToken"
      },
      {
        "source": "/api/paytrCallback",
        "function": "paytrCallback"
      },
      {
        "source": "/api/getOrderStatus",
        "function": "getOrderStatus"
      },
      {
        "source": "/api/completeHighValueDelivery",
        "function": "completeHighValueDelivery"
      },
      {
        "source": "/api/issueEvidenceAccessToken",
        "function": "issueEvidenceAccessToken"
      },
      {
        "source": "/api/getOrderEvidence",
        "function": "getOrderEvidence"
      }
    ],
    "redirects": [
      {
        "source": "/seckin-urunler",
        "destination": "/elit-kategori/",
        "type": 301
      },
      {
        "source": "/seckin-urunler/**",
        "destination": "/elit-kategori/",
        "type": 301
      },
      {
        "source": "/ikinci-el",
        "destination": "/elit-kategori/",
        "type": 301
      },
      {
        "source": "/ikinci-el/**",
        "destination": "/elit-kategori/",
        "type": 301
      }
    ]
  }
}
